#!/usr/bin/env bash
# `agentltl` CLI (on Claude's PATH while the plugin is enabled): validate, check, tools, trace.
# Runs the guard's code from this plugin directory with the plugin's virtualenv.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
for c in "${AGENTLTL_CC_PYTHON:-}" \
         "${CLAUDE_PLUGIN_DATA:+$CLAUDE_PLUGIN_DATA/venv/bin/python}" \
         "$HOME"/.claude/plugins/data/agentltl-claude-code*/venv/bin/python \
         "$root/.venv/bin/python"; do
    if [[ -n "$c" && -x "$c" ]]; then
        PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$c" -m agentltl_cc.cli "$@"
    fi
done
echo "agentltl: the guard is not installed; run $root/scripts/setup.sh" >&2
exit 1
