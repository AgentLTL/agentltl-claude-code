#!/usr/bin/env bash
# `agentltl` CLI (on Claude's PATH while the plugin is enabled): validate, check, tools, trace.
# Runs the guard's code from this plugin directory with the plugin's virtualenv, building it
# first if this version's dependency pins have none yet (see scripts/env.sh).
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../scripts/env.sh
source "$root/scripts/env.sh"
py="$(env_python)"
if [[ -z "$py" && "$1" == "statusline" && $# -eq 1 ]]; then
    # The status line must not wait for a build: start one in the background, unless one is
    # running, and show that it is on its way. (`statusline --install` builds it in front.)
    if [[ ! -d "$(dirname "$(env_venv)")/.setup.lock" ]]; then
        (env_build </dev/null >/dev/null 2>&1 &)
    fi
    echo "AgentLTL ○ setting up"
    exit 0
fi
[[ -n "$py" ]] || { env_build && py="$(env_python)"; }
if [[ -z "$py" ]]; then
    echo "agentltl: the guard is not installed; run $root/scripts/setup.sh" >&2
    exit 1
fi
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m agentltl_cc.cli "$@"
