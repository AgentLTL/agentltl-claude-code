{
  "description": "AgentLTL for Claude Code: checks every tool call, shell commands included, against AGENTLTL.yaml",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run SessionStart", "timeout": 600}]}
    ],
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run PreToolUse", "timeout": 120}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run UserPromptSubmit", "timeout": 60}]}
    ],
    "PostToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run PostToolUse", "timeout": 120}]}
    ]
  }
}
