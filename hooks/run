#!/usr/bin/env bash
# Hook launcher: finds the plugin's Python and runs the guard from this plugin directory.
# $1 is the hook event. On SessionStart it builds the virtualenv first if it is missing, or
# rebuilds it when vendor.lock changed (a plugin update that moved a dependency pin).
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

find_python() {
    local c
    for c in "${AGENTLTL_CC_PYTHON:-}" \
             "${CLAUDE_PLUGIN_DATA:+$CLAUDE_PLUGIN_DATA/venv/bin/python}" \
             "$root/.venv/bin/python"; do
        if [[ -n "$c" && -x "$c" ]]; then echo "$c"; return 0; fi
    done
    return 1
}

py="$(find_python)"
if [[ "$1" == "SessionStart" ]]; then
    stale=1
    [[ -n "$py" ]] && cmp -s "$root/vendor.lock" "$(dirname "$(dirname "$py")")/vendor.lock" && stale=0
    if [[ -z "$py" || ( $stale == 1 && -z "${AGENTLTL_CC_PYTHON:-}" ) ]]; then
        "$root/scripts/setup.sh" >&2 && py="$(find_python)"
    fi
fi
if [[ -z "$py" ]]; then
    # Not installed. Stay out of the way unless rules exist, in which case say so loudly.
    if [[ -f "${CLAUDE_PROJECT_DIR:-.}/AGENTLTL.yaml" || -f "$HOME/.claude/AGENTLTL.yaml" ]]; then
        msg="AgentLTL for Claude Code is not installed (run $root/scripts/setup.sh); rules are not enforced."
        if [[ "$1" == "PreToolUse" ]]; then
            printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}' "$msg"
        else
            printf '{"systemMessage":"%s"}' "$msg"
        fi
    fi
    exit 0
fi
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m agentltl_cc.hook
